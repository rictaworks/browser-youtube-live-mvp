# 環境変数の名前だけを記載する。値は .env に書き、リポジトリへ入れない（requirements.md 28.1・29.4）。
# 本番の値は Railway Variables と Vercel Environment Variables に設定する。
#
# 開発環境の .env は scripts/setup_dev_env.sh が生成する（不足している変数だけを追記し、既存の値は上書きしない）。
# .env に RAILS_ENV を書かない（テストが development 環境で走る事故を防ぐため。
# docker-compose.yml と scripts/test_backend.sh が環境を明示する）。

# --- アプリケーション（Rails） ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
RECAPTCHA_SECRET_KEY=
ADMIN_BASIC_USER=
ADMIN_BASIC_PASSWORD=
# PostgreSQL の接続先。本番は Railway が与える。
# 開発環境は docker-compose.yml が POSTGRES_USER・POSTGRES_PASSWORD から組み立てる（.env に書かない）。
DATABASE_URL=
# ブラウザへ返す中継の接続先。完全な WebSocket の URL（ws(s)://…/ws）で書く。
RELAY_PUBLIC_URL=

# --- フロントエンド（Next.js） ---
RECAPTCHA_SITE_KEY=
BACKEND_ORIGIN=

# --- 中継（Gin / Go） ---
BACKEND_INTERNAL_URL=

# --- 複数の層で同じ値を設定する秘密値 ---
# アプリケーションと中継
RELAY_SHARED_SECRET=
# フロントエンドとアプリケーション
BFF_SHARED_SECRET=

# --- 開発環境の db コンテナ（docker-compose.yml が使う。本番では使わない） ---
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- 並行して複数の開発環境を起動するときだけ使う、任意の変数（既定のままなら書かない） ---
# 環境変数としても、.env にも書ける。書く場合は、行頭の # を外して値を入れる。
# FRONTEND_PORT          frontend をホストへ公開するポート（既定 3000）
# BACKEND_PORT           backend の公開側をホストへ公開するポート（既定 3001）
# RELAY_PORT             relay をホストへ公開するポート（既定 3002）。変えたら RELAY_PUBLIC_URL の口も合わせる
# COMPOSE_PROJECT_NAME   docker compose のプロジェクト名。コンテナ・ネットワーク・db のボリュームの名前になる（既定 browser-youtube-live-mvp）
# TEST_DB_NAME           scripts/test_backend.sh が使うテスト用 DB の名前（既定 bl_test）。test を 1 つの語として含む名前にする
