# 環境変数の名前だけを記載する。値は .env に書き、リポジトリへ入れない（requirements.md 28.1・29.4）。
# 本番の値は Railway Variables と Vercel Environment Variables に設定する。

# --- アプリケーション（Rails） ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
RECAPTCHA_SECRET_KEY=
ADMIN_BASIC_USER=
ADMIN_BASIC_PASSWORD=
DATABASE_URL=
RELAY_PUBLIC_URL=

# --- フロントエンド（Next.js） ---
RECAPTCHA_SITE_KEY=
BACKEND_ORIGIN=

# --- 中継（Gin / Go） ---
BACKEND_INTERNAL_URL=

# --- 複数の層で同じ値を設定する秘密値 ---
# アプリケーションと中継
RELAY_SHARED_SECRET=
# フロントエンドとアプリケーション
BFF_SHARED_SECRET=
