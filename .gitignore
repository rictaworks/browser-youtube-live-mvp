# --- Secrets（最優先・コミット事故の再発防止） ---
.env
.env.*
!.env.example
config/master.key
**/config/master.key
**/config/credentials/*.key
*.pem
*.key
!*.pub.key

# --- .claude/ の扱いはリポジトリの公開設定で決める ---
# PUBLICリポジトリ：以下を有効化し、.claude/を丸ごと除外する（社内ノウハウの公開防止。questboardで実施済み）
.claude/*
#
# PRIVATEリポジトリ：上の行をコメントアウトし、.claude/を丸ごとコミットする
# （露出リスクが無く、クローン直後からsettings.json・agents・workflowsが動く。x-follower-gateで実施済み）

# --- ノウハウ・非公開ディレクトリ（公開/非公開に関わらず常に除外） ---
CLIENT/
DEBUG/
TASKS/
WORK/
DELETE/
ENV/

# --- Rails ---
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
.byebug_history
/public/assets
# Rails は src/backend/ の内側に置く（requirements.md 2.6）ため、同じ除外を内側にも適用する
/src/backend/log/*
/src/backend/tmp/*
/src/backend/storage/*
!/src/backend/log/.keep
!/src/backend/tmp/.keep
!/src/backend/storage/.keep
/src/backend/public/assets

# --- Node / Next.js / Vercel ---
node_modules/
.next/
out/
.vercel

# --- Python / FastAPI ---
__pycache__/
*.pyc
.venv/
venv/

# --- Go ---
/bin/
/src/relay/bin/

# --- 開発環境（docker compose）が各層のディレクトリ内へ作る依存・キャッシュ ---
# コンテナはホストの UID・GID で動くため、これらもホストのユーザーの所有になる（root 所有のファイルを作らない）
# Ruby の gem（BUNDLE_PATH）、bundler の設定、各層のツールの HOME・npm・Go のキャッシュと開発用のビルド結果
/src/backend/vendor/bundle/
/src/backend/.bundle/
/src/backend/.cache/
/src/frontend/.cache/
/src/relay/.cache/
# Next.js が自動生成する型の参照・SWC のプラグインの置き場と、TypeScript の増分ビルドの記録
/src/frontend/next-env.d.ts
/src/frontend/.swc/
*.tsbuildinfo

# --- Rust / Tauri ---
target/
src-tauri/target/

# --- Unity ---
/Library/
/Temp/
/Obj/
/Build/
/Logs/
/UserSettings/
/MemoryCaptures/
*.csproj
*.sln

# --- Playwright ---
test-results/
playwright-report/
/.playwright-mcp/

# --- エディタ・OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*Zone.Identifier

# --- テスト・カバレッジ ---
coverage/
.rspec_status
